FROM node:20-slim

# node:20-slim is Debian-based, so apt works for installing Python alongside it
RUN apt-get update && \
    apt-get install -y python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
EXPOSE 5173
EXPOSE 8000

COPY start.sh /start.sh
RUN chmod +x /start.sh
CMD ["/start.sh"]