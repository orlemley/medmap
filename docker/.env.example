# Copy this file to docker/.env and edit it to change MedMap's Docker
# settings. docker/.env is git-ignored, so each person keeps their own.
# Every value below is the default, so you only need the lines you change.

# Port on this computer for the site + API (http://localhost:8000).
MEDMAP_PORT=8000

# Port for the hot-reload dev server (`--profile dev`).
WEB_DEV_PORT=5173

# How many (radius, state) score tables the server keeps in memory.
# Each nationwide one is ~40 MB; the server itself uses ~95 MB.
MEDMAP_CACHE_SIZE=6

# Leave empty to use the built-in placeholder scoring. Point it at another
# service that implements GET /api/optimize to use that instead, e.g. the
# algorithm container sketched at the bottom of docker-compose.yml:
# OPTIMIZER_URL=http://algorithm:8000
OPTIMIZER_URL=
