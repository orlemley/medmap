# --- Shapefile components (never commit raw GIS data) ---
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.fbn
*.fbx
*.ain
*.aih
*.atx
*.ixs
*.mxs
*.qix
*.shp.xml   # shapefile metadata sidecar

# --- Other common geospatial formats ---
*.gpkg      # GeoPackage
*.geojson
*.kml
*.kmz
*.gml
*.tif
*.tiff      # GeoTIFF rasters
*.asc       # ASCII grid rasters
*.nc        # NetCDF
*.gdb/      # File geodatabase (it's actually a folder)
*.gdb.zip

# --- Generic large/data files ---
*.csv
*.zip
/data/raw/
/data/stage1/
__pycache__/

*.7z
data/
raw*/
*.parquet

# Generated Docker runtime bundle (a safe copy of active Stage 5/7/8 runs).
!/docker/runtime-data/.gitkeep
!/docker/runtime-data/

# --- Python ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
venv/
.venv/
*.egg-info/

# --- Env / secrets ---
.env
*.env.local

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/
